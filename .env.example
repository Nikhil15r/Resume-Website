# ==============================================================================
# ATELIER CV — Authentication & Cloud Sync Configuration (100% Free Tier)
# ==============================================================================
# 1. Open your project at https://supabase.com/dashboard
# 2. Go to Project Settings -> Data API (or General) and copy your Project URL.
# 3. Go to Project Settings -> API Keys and copy your Publishable Key (sb_publishable_...) or Anon Key.
# 4. Copy this file to .env.local for local development, AND add both variables
#    in Vercel under Project Settings -> Environment Variables.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# Note: VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY, VITE_SUPABASE_PUBLISHABLE_KEY,
# NEXT_PUBLIC_SUPABASE_URL, and NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
# are also supported automatically via vite.config.ts and src/utils/supabaseClient.ts.

# Optional: To enable Google OAuth in Supabase:
# - Go to Authentication -> Providers -> Google in your Supabase dashboard
# - Add your Google Cloud Console Client ID and Client Secret
# - Under Authentication -> URL Configuration -> Redirect URLs, add:
#   http://localhost:5173/auth/callback
#   https://ateliercv.vercel.app/auth/callback
#   https://ateliercv.vercel.app/auth/reset-password
